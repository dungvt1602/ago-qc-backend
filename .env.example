# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đẩy .env lên Git.

# Cổng server chạy local
PORT=8080

# PostgreSQL — lấy ở Supabase: Project Settings > Database > Connection string > URI
# Nhớ thay [YOUR-PASSWORD] bằng mật khẩu database thật.
DATABASE_URL=postgresql://postgres.[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Storage — lấy ở Project Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_SERVICE_KEY=   # service_role key — CHỈ để ở backend, không lộ ra frontend
PHOTO_BUCKET=qc-photos
PDF_BUCKET=qc-pdfs

# Domain frontend được phép gọi (CORS). Nhiều domain ngăn cách bằng dấu phẩy.
# Dùng * để cho phép tất cả khi đang test local.
CORS_ORIGIN=*

# Khóa bí mật đơn giản (tùy chọn). Để trống = không kiểm tra.
API_SECRET=

# === Tích hợp gRPC với backend checklist (Go) ===
# Cổng gRPC — chỉ mở trên mạng riêng Render, Internet không thấy.
QC_GRPC_PORT=50051
# Khóa xác thực: backend Go gửi metadata x-api-key trên mọi call. Để TRỐNG = KHÔNG bật gRPC.
# Sinh khóa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QC_APP_API_KEY=
# Địa chỉ frontend (không dấu / cuối) — gRPC GetStatus trả file_url = <QC_APP_URL>/qc/<id> cho checklist.
QC_APP_URL=https://ago-qc.netlify.app
# Đồng bộ thông tin đơn -> hồ sơ QC (PLAN-0043). Mặc định TẮT (để trống / false).
# true/1/yes/on = hồ sơ có order_id thì 9 ô do đơn sở hữu (nơi sản xuất, số cont, seal, ngày đóng cont, khách,
# tên SP, quy cách, SL, đơn vị) là CHỈ-ĐỌC: HTTP updateQCFile bỏ các ô đó khỏi payload. Chỉ bật SAU KHI đợt
# đồng bộ đầu từ checklist đã chạy xong. gRPC SyncOrderInfo không bị cờ này chi phối.
QC_ORDER_FIELDS_READONLY=
